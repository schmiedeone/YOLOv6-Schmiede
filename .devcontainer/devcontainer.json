{
    "name": "YOLOv6-Schmiede",
    "image": "yolov6-schmiede:latest",
    "workspaceFolder": "/workspace",
    "runArgs": [
        "--gpus=all",
        "--ipc=host"
    ],
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
        "source=/usr/bin/nvidia-smi,target=/usr/bin/nvidia-smi,type=bind,readonly"],
    "remoteEnv": {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "PYTHONPATH": "/opt/conda/lib/python3.10/site-packages:${PYTHONPATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.isort",
                "ms-python.flake8",
                "ms-python.black-formatter",
                "ms-vscode.cpptools",
                "xaver.clang-format"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/opt/conda/bin/python",
                "python.analysis.extraPaths": ["/workspace"],
                "jupyter.notebookFileRoot": "/workspace"
            }
        }
    },
    "postCreateCommand": "python -m pip install ipykernel && python -m ipykernel install --user --name=python3 && git config --global --add safe.directory '*'",
    "postStartCommand": "bash -c 'source /opt/conda/bin/activate base && nvidia-smi'"
}
